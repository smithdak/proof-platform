{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["operation", "data"],
  "properties": {
    "operation": {"type": "string", "const": "object.create"},
    "data": {
      "type": "object",
      "required": ["object", "content_digest"],
      "properties": {
        "object": {"$ref": "#/definitions/object"},
        "content_digest": {"type": "string"}
      }
    }
  },
  "definitions": {
    "object": {
      "type": "object",
      "required": ["id", "schema_id", "schema_version", "locale", "content", "revision", "created_at", "updated_at", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "schema_id": {"type": "string", "format": "uuid"},
        "schema_version": {"type": "integer"},
        "locale": {"type": "string"},
        "content": {},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "submitted", "approved", "committed", "published"]}
      }
    }
  }
}
