{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["operation", "data"],
  "properties": {
    "operation": {"type": "string", "const": "edition.create"},
    "data": {
      "type": "object",
      "required": ["edition"],
      "properties": {
        "edition": {
          "type": "object",
          "required": ["id", "changeset_id", "objects", "created_at", "content_digest"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "changeset_id": {"type": "string", "format": "uuid"},
            "objects": {"type": "array", "items": {"$ref": "#/definitions/object"}},
            "created_at": {"type": "string", "format": "date-time"},
            "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "object": {
      "type": "object",
      "required": ["id", "schema_id", "schema_version", "locale", "content", "revision", "created_at", "updated_at", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "schema_id": {"type": "string", "format": "uuid"},
        "schema_version": {"type": "integer", "minimum": 1},
        "locale": {"type": "string"},
        "content": {},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["draft", "submitted", "approved", "committed", "published"]}
      },
      "additionalProperties": false
    }
  }
}
