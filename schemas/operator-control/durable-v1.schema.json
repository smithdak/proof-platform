{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof.local/schemas/operator-control/durable/v1",
  "title": "Proof operator control v1 durable and runtime shapes",
  "type": "object",
  "maxProperties": 0,
  "additionalProperties": false,
  "$defs": {
    "PrincipalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "kind",
        "public_key",
        "public_key_fingerprint"
      ],
      "properties": {
        "principal_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        },
        "public_key": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Ed25519PublicKey"
        },
        "public_key_fingerprint": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        }
      }
    },
    "DescriptorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode"],
      "properties": {
        "device": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/SafeInteger" },
        "inode": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/PositiveSafeInteger" }
      }
    },
    "WorkspaceFingerprintInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "workspace_id", "proof_directory", "control_lock",
        "agent_key_file", "human_key_file", "agent_id", "human_id",
        "agent_public_key", "human_public_key"
      ],
      "properties": {
        "schema": { "const": "proof.operator.workspace-fingerprint-input/v1" },
        "workspace_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "proof_directory": { "$ref": "#/$defs/DescriptorIdentity" },
        "control_lock": { "$ref": "#/$defs/DescriptorIdentity" },
        "agent_key_file": { "$ref": "#/$defs/DescriptorIdentity" },
        "human_key_file": { "$ref": "#/$defs/DescriptorIdentity" },
        "agent_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "human_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "agent_public_key": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Ed25519PublicKey" },
        "human_public_key": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Ed25519PublicKey" }
      }
    },
    "SchemaCatalogEntryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "version", "registry_entry_path",
        "registry_entry_sha256", "input_schema_path",
        "input_schema_sha256", "output_schema_path", "output_schema_sha256"
      ],
      "properties": {
        "operation": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/OperationName" },
        "version": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/OperationVersion" },
        "registry_entry_path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"
        },
        "registry_entry_sha256": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ArtifactDigest" },
        "input_schema_path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"
        },
        "input_schema_sha256": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ArtifactDigest" },
        "output_schema_path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"
        },
        "output_schema_sha256": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ArtifactDigest" }
      }
    },
    "SchemaCatalogBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "entries"],
      "properties": {
        "schema": { "const": "proof.operator.schema-catalog-binding/v1" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SchemaCatalogEntryBinding" }
        }
      }
    },
    "OperatorWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workspace_id",
        "database_name",
        "fingerprint_input",
        "workspace_fingerprint",
        "schema_catalog_digest",
        "agent",
        "human",
        "auth_epoch",
        "policy_revision",
        "capabilities",
        "created_at",
        "updated_at",
        "binding_digest"
      ],
      "properties": {
        "schema": {
          "const": "proof-operator-workspace/v1"
        },
        "workspace_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "database_name": {
          "const": "storage.db"
        },
        "fingerprint_input": {
          "$ref": "#/$defs/WorkspaceFingerprintInput"
        },
        "workspace_fingerprint": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        },
        "schema_catalog_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        },
        "agent": {
          "$ref": "#/$defs/PrincipalBinding"
        },
        "human": {
          "$ref": "#/$defs/PrincipalBinding"
        },
        "auth_epoch": {
          "const": 1
        },
        "policy_revision": {
          "const": 1
        },
        "capabilities": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/CapabilitySet"
        },
        "created_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "updated_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "binding_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        }
      }
    },
    "HumanEnrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workspace_id",
        "human",
        "capabilities",
        "capability_set_digest",
        "enrolled_at"
      ],
      "properties": {
        "schema": {
          "const": "proof-operator-human-enrollment/v1"
        },
        "workspace_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "human": {
          "$ref": "#/$defs/PrincipalBinding"
        },
        "capabilities": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/CapabilitySet"
        },
        "capability_set_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        },
        "enrolled_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        }
      }
    },
    "BudgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "budget_id",
        "workspace_id",
        "limits",
        "deadline_at",
        "limits_digest"
      ],
      "properties": {
        "schema": {
          "const": "proof.operator.budget-policy/v1"
        },
        "budget_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "workspace_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "limits": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/BudgetAmounts"
        },
        "deadline_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "limits_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        }
      }
    },
    "BudgetAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "policy",
        "revision",
        "state",
        "reserved",
        "committed",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema": {
          "const": "proof-operator-budget-account/v1"
        },
        "policy": {
          "$ref": "#/$defs/BudgetPolicy"
        },
        "revision": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/SafeInteger"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "closed",
            "exhausted"
          ]
        },
        "reserved": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/BudgetAmounts"
        },
        "committed": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/BudgetAmounts"
        },
        "created_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "updated_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        }
      }
    },
    "RunControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "workspace_id",
        "budget_id",
        "control_revision",
        "active_dispatch_reservation_id",
        "recovery_directive_id",
        "recovery_directive_digest",
        "last_command_id",
        "created_at",
        "updated_at",
        "binding_digest"
      ],
      "properties": {
        "schema": {
          "const": "proof-operator-run-control/v1"
        },
        "run_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "workspace_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "budget_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "control_revision": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/SafeInteger"
        },
        "active_dispatch_reservation_id": {
          "oneOf": [
            {
              "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_directive_id": {
          "oneOf": [
            { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
            { "type": "null" }
          ]
        },
        "recovery_directive_digest": {
          "oneOf": [
            { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" },
            { "type": "null" }
          ]
        },
        "last_command_id": {
          "oneOf": [
            {
              "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "updated_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "binding_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        }
      },
      "oneOf": [
        {
          "properties": {
            "recovery_directive_id": { "type": "null" },
            "recovery_directive_digest": { "type": "null" }
          }
        },
        {
          "properties": {
            "recovery_directive_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
            "recovery_directive_digest": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" }
          }
        }
      ]
    },
    "RunLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "workspace_id",
        "lease_id",
        "owner_instance_id",
        "process_epoch_id",
        "lease_token_digest",
        "fence_epoch",
        "revision",
        "state",
        "acquired_at",
        "renewed_at",
        "expires_at",
        "released_at",
        "lease_digest"
      ],
      "properties": {
        "schema": {
          "const": "proof.operator.run-lease/v1"
        },
        "run_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "workspace_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "lease_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "owner_instance_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "process_epoch_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "lease_token_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        },
        "fence_epoch": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/PositiveSafeInteger"
        },
        "revision": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/SafeInteger"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "released"
          ]
        },
        "acquired_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "renewed_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "expires_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "released_at": {
          "oneOf": [
            {
              "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": { "const": "active" },
            "released_at": { "type": "null" }
          }
        },
        {
          "properties": {
            "state": { "const": "released" },
            "released_at": {
              "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
            }
          }
        }
      ]
    },
    "DispatchIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "kind", "operation", "version", "adapter", "model",
        "argument_digest", "ceiling"
      ],
      "properties": {
        "schema": { "const": "proof.operator.dispatch-intent/v1" },
        "kind": { "type": "string", "enum": ["provider", "tool"] },
        "operation": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/OperationName" },
        "version": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/OperationVersion" },
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "model": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$" },
            { "type": "null" }
          ]
        },
        "argument_digest": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" },
        "ceiling": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/BudgetAmounts" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "provider" },
            "model": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "tool" },
            "model": { "type": "null" }
          }
        }
      ]
    },
    "ReplayClaimBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "policy", "workspace_id", "run_id", "step_id",
        "checkpoint_id", "checkpoint_sequence", "checkpoint_digest",
        "operation", "version", "idempotency_key", "input_digest",
        "claimed_by", "binding_digest"
      ],
      "properties": {
        "schema": { "const": "proof.operator.replay-claim-binding/v1" },
        "policy": { "const": "required_uuidv7_exact_replay" },
        "workspace_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "run_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "step_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "checkpoint_id": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "checkpoint_sequence": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/SafeInteger" },
        "checkpoint_digest": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/KernelContentDigest" },
        "operation": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/OperationName" },
        "version": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/OperationVersion" },
        "idempotency_key": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "input_digest": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/KernelContentDigest" },
        "claimed_by": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
        "binding_digest": { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" }
      }
    },
    "BudgetReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reservation_id",
        "budget_id",
        "run_id",
        "lease_id",
        "fence_epoch",
        "idempotency_key",
        "request_digest",
        "kind",
        "intent",
        "intent_digest",
        "replay",
        "recovery",
        "state",
        "reserved",
        "charged",
        "created_at",
        "permit_id",
        "dispatch_token_digest",
        "call_digest",
        "prepared_execution_digest",
        "result_digest",
        "prepared_binding",
        "runtime_commit",
        "dispatch_started_at",
        "settled_at"
      ],
      "properties": {
        "schema": {
          "const": "proof-operator-budget-reservation/v1"
        },
        "reservation_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "budget_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "run_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "lease_id": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "fence_epoch": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/PositiveSafeInteger"
        },
        "idempotency_key": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7"
        },
        "request_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        },
        "kind": {
          "type": "string",
          "enum": [
            "provider",
            "tool"
          ]
        },
        "intent": { "$ref": "#/$defs/DispatchIntent" },
        "intent_digest": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest"
        },
        "replay": {
          "oneOf": [
            { "$ref": "#/$defs/ReplayClaimBinding" },
            { "type": "null" }
          ]
        },
        "recovery": {
          "oneOf": [
            { "$ref": "#/$defs/RecoveryDirective" },
            { "type": "null" }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "committed",
            "dispatching",
            "forfeited",
            "released",
            "reserved"
          ]
        },
        "reserved": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/BudgetAmounts"
        },
        "charged": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/BudgetAmounts"
        },
        "created_at": {
          "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/Rfc3339Utc"
        },
        "permit_id": {
          "oneOf": [
            { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/UuidV7" },
            { "type": "null" }
          ]
        },
        "dispatch_token_digest": {
          "oneOf": [
            { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" },
            { "type": "null" }
          ]
        },
        "call_digest": {
          "oneOf": [
            { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" },
            { "type": "null" }
          ]
        },
        "prepared_execution_digest": {
          "oneOf": [
            { "$ref": "https://proof.local/schemas/operator-control/common/v1#/$defs/ControlDigest" },
            { "type": "null" }
          ]
        },
        "result_digest": {
          "oneOf": [
