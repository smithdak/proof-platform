    ],
    "request_required_fields": [
      "endpoint", "requested_model", "previous_response_id", "instructions",
      "input", "instructions_digest", "input_digest", "parameters_schema_digest", "tool_declaration_digest",
      "tool_set_digest", "request_body_digest", "function_names",
      "tool_declarations", "tool_choice", "max_output_tokens", "service_tier",
