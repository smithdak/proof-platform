      "bindings_digest",
      "resolved_policy_digest",
      "check_set_digest",
      "tamper_vector_set_digest",
      "pricing_schedule_digest",
      "complete_trace_digest"
    ],
    "recompute_check_and_tamper_sets": true,
    "reject_missing_duplicate_added_or_reordered_ids": true
  },
  "external_effects": {
    "approved": [
      "one direct OpenAI Responses journey within the authorized dispatch and spend limits",
      "one local immutable preview artifact after signed approval"
    ],
    "prohibited": [
      "unapproved network calls",
      "external preview deployment",
      "production publication",
      "hosting",
      "CMS mutation",
      "destructive cleanup"
    ]
  }
