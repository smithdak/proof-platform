      "pricing_schedule_digest",
      "instructions_digest", "initial_input_digest", "parameters_schema_digest",
      "tool_declaration_digest", "tool_set_digest"
    ],
    "provider_required_fields": [
      "name", "endpoint", "requested_model", "service_tier", "tool_choice",
