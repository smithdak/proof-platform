{
  "schema": "proof-release-manager-live-policy/v1",
  "policy_id": "release-manager-live-preview-v1",
  "mode": "live",
  "contract": "proof-release-manager-live/v1",
  "unknown_fields": "reject",
  "edition_dependencies": {
    "W2": {
      "E0001-06": ["E0001-01"],
      "E0001-07": ["E0001-01"]
    },
    "W3": {
      "E0001-02": ["E0001-01", "E0001-06", "E0001-07"],
      "E0001-03": ["E0001-01", "E0001-06", "E0001-07"]
    },
    "W4": {
      "E0001-08": ["E0001-01", "E0001-02", "E0001-03", "E0001-06", "E0001-07"]
    },
    "W5": {
      "E0001-04": ["E0001-02", "E0001-03", "E0001-06", "E0001-07", "E0001-08"]
