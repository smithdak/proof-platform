  "required_final_output_references": [
    {"call_index": 0, "source": "arguments", "pointer": "/edition_id"},
    {"call_index": 0, "source": "arguments", "pointer": "/environment"},
    {"call_index": 0, "source": "arguments", "pointer": "/version_label"},
    {"call_index": 0, "source": "arguments", "pointer": "/manifest_digest"},
    {"call_index": 0, "source": "output", "pointer": "/data/publication_id"},
    {"call_index": 0, "source": "output", "pointer": "/data/artifact/relative_path"},
    {"call_index": 0, "source": "output", "pointer": "/data/artifact/digest"},
    {"call_index": 0, "source": "proof_id"}
  ],
  "checks": [
    {"id": "deterministic_preflight", "required": true},
    {"id": "sealed_policy_and_trace", "required": true},
    {"id": "provider_endpoint_model", "required": true},
    {"id": "synthetic_data_boundary", "required": true},
    {"id": "identity_authority_allowlist", "required": true},
    {"id": "exact_tool_call", "required": true},
    {"id": "approval_integrity", "required": true},
    {"id": "approval_restart_chronology", "required": true},
    {"id": "provider_attempt_recovery", "required": true},
    {"id": "budgets", "required": true},
    {"id": "cost_accounting", "required": true},
    {"id": "artifact_identity_manifest", "required": true},
    {"id": "artifact_file_integrity", "required": true},
    {"id": "proof_integrity", "required": true},
    {"id": "exact_replay_single_effect", "required": true},
    {"id": "terminal_report", "required": true},
    {"id": "no_failure_or_unapproved_external_effect", "required": true}
  ],
  "check_set": {
    "expected_cardinality": 17,
    "require_unique_ids": true,
    "require_exact_ordered_set": true,
    "required_passed_checks": 17,
    "required_total_checks": 17,
    "required_score_bps": 10000,
    "digest_schema": "proof-release-manager-live-check-set-digest/v1",
    "digest_algorithm": "blake3-256"
  },
  "tamper_vectors": [
    "preflight_record_policy_trace_score_count_or_digest_change",
    "binding_change_unresolved_binding_or_circular_digest_field",
    "check_id_cardinality_order_or_exact_set_digest_change",
    "provider_requested_returned_model_endpoint_or_setting_substitution",
    "function_name_description_parameters_schema_tool_set_or_request_body_substitution",
    "provider_attempt_state_request_retry_response_cost_usage_or_epoch_change",
    "dispatching_checkpoint_event_reread_barrier_missing_or_reordered",
    "ambiguous_attempt_reclassified_as_retryable_or_committed",
    "delegation_id_row_digest_scope_chain_recipient_validity_or_revocation_change",
    "approval_request_argument_version_expiry_or_signature_change",
    "approver_identity_key_outcome_signature_or_chronology_change",
    "missing_restart_or_execution_before_approval",
    "artifact_path_traversal_second_file_bytes_or_digest_change",
    "artifact_edition_environment_version_manifest_actor_or_timestamp_change",
    "operation_output_publication_artifact_or_manifest_change",
    "proof_id_body_signature_actor_delegation_digest_or_timestamp_change",
    "replay_output_proof_substitution_or_second_mutation",
    "usage_call_token_duration_retry_price_schedule_or_cost_change",
    "failure_event_unallowlisted_call_content_mutation_or_unapproved_external_effect",
    "terminal_output_reference_removed_or_substituted"
  ],
  "tamper_vector_set": {
    "expected_cardinality": 20,
    "require_unique_ids": true,
    "require_exact_ordered_set": true,
    "digest_schema": "proof-release-manager-live-tamper-vector-set-digest/v1",
    "digest_algorithm": "blake3-256"
  },
  "score": {
    "scale_bps": 10000,
    "required_bps": 10000,
    "all_required_checks_must_pass": true
  },
  "binding": {
    "digest_algorithm": "blake3-256",
    "require_template_digest": true,
    "require_preflight_evidence_digest": true,
    "require_bindings_digest": true,
    "require_resolved_policy_digest": true,
    "require_check_set_digest": true,
    "require_tamper_vector_set_digest": true,
    "require_pricing_schedule_digest": true,
    "require_complete_trace_digest_after_terminal_seal": true,
    "evaluation_rows_append_only": true
