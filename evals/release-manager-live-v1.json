      "usage", "provider_cost_microusd", "provider_cost_status",
      "calculated_cost_microusd", "cumulative_input_tokens",
      "cumulative_output_tokens", "cumulative_total_tokens",
      "cumulative_provider_cost_microusd", "cumulative_provider_cost_status",
      "cumulative_calculated_cost_microusd", "pricing_schedule_id",
      "pricing_schedule_digest"
    ],
    "failure_required_fields": ["class", "code", "detail"],
    "states": [
      "prepared", "dispatching", "response_received", "committed",
      "rejected_retryable", "failed_retryable", "failed_terminal", "ambiguous"
    ],
    "failure_classes": ["certified_no_bytes", "explicit_429", "terminal", "ambiguous"],
    "maximum_retries_total": 1,
    "automatic_retry_after_ambiguous": false,
    "require_same_request_digest_on_retry": true,
    "require_retry_lineage": true,
    "require_committed_response_before_tool_dispatch": true,
    "require_process_epoch_change_after_approval": true,
    "dispatch_barrier": {
      "required_state": "dispatching",
      "increment_dispatch_counter": true,
      "persist_checkpoint": true,
      "append_model_requested_event": true,
      "reread_and_compare_both": true,
      "complete_before_any_request_byte": true,
      "restart_from_dispatching_is_ambiguous": true
    },
    "invariants": [
      "attempts_append_only",
      "dispatch_ordinals_contiguous",
      "counters_equal_event_and_attempt_ledgers",
      "cumulative_usage_equals_committed_response_sum",
      "cumulative_cost_equals_committed_response_sum",
      "retry_lineage_acyclic",
      "request_tool_policy_and_pricing_digests_immutable",
      "previous_response_id_advances_only_from_committed_response",
      "requested_and_returned_model_match",
      "terminal_state_cannot_clear",
      "resume_changes_process_epoch_without_resetting_cumulative_values"
    ]
  },
  "limits": {
    "max_provider_dispatches": 4,
    "max_logical_model_turns": 3,
    "max_tool_attempts": 2,
    "required_tool_attempts_for_pass": 1,
