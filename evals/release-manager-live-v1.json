    "W6": {
      "E0001-05": [
        "E0001-01", "E0001-02", "E0001-03", "E0001-04",
        "E0001-06", "E0001-07", "E0001-08"
      ]
    }
  },
  "deterministic_preflight": {
    "policy_path": "evals/release-manager-preview-v1.json",
    "evaluator": "proof-agent-trace/v1",
    "required_outcome": "passed",
    "required_score_bps": 10000,
    "required_checks_passed": 10,
    "required_checks_total": 10,
    "evidence_schema": "proof-release-manager-preflight-evidence/v1",
    "digest_schema": "proof-release-manager-preflight-evidence-digest/v1",
    "required_record_fields": [
      "schema",
      "policy_path",
      "policy_digest",
      "trace_digest",
      "evaluator",
      "run_id",
      "evaluation_id",
      "evaluation_created_at",
      "outcome",
      "score_bps",
      "passed_checks",
      "total_checks"
    ],
    "reject_unknown_record_fields": true,
    "persist_immutable_record_and_digest": true,
    "require_before_credential_read": true,
    "require_before_provider_construction": true,
    "require_before_live_run_creation": true
  },
  "bindings": {
    "schema": "proof-release-manager-live-bindings/v1",
    "required": [
      "preflight_evidence_digest",
      "run_id",
      "agent_id",
      "agent_principal_id",
      "approver_principal_id",
      "delegation_id",
      "delegation_digest",
      "edition_id",
      "manifest_digest",
      "idempotency_key",
      "version_label",
      "process_epoch_id"
    ],
    "reject_unknown": true,
    "resolve_before_provider_dispatch": true,
    "persist_template_binding_and_resolved_digests": true,
    "forbid_self_digest_fields": true
  },
  "authority": {
    "require_explicit_delegation_id": true,
    "require_matching_chain_entry": true,
    "allow_chain_only": false,
    "required_allowed_operations": ["release.publish"],
    "required_allowed_domains": ["content"],
    "scope_json_allowed_keys": [
      "allowed_operations",
      "allowed_domains",
      "resource_scope"
    ],
    "scope_json_reject_unknown_keys": true,
    "scope_json_storage_local_strict_dto": true,
    "exact_live_scope_forbids_resource_scope": true,
    "allow_default_scope": false,
    "allow_wildcard_scope": false,
    "allow_additional_scope": false,
    "require_valid_through_run_deadline": true,
    "require_not_revoked": true,
    "require_loaded_sqlite_row": true
  },
  "provider": {
    "name": "openai",
    "endpoint": "https://api.openai.com/v1/responses",
    "require_base_url_unset": true,
    "model": "gpt-5.6-sol",
    "require_returned_model_match": true,
    "store": true,
    "stream": false,
    "background": false,
    "parallel_tool_calls": false,
    "tool_choice": "auto",
    "allowed_tool_types": ["function"],
    "resend_instructions_on_continuation": true,
    "continuation": "previous_response_id",
    "service_tier": "default",
    "max_output_tokens": 1024
  },
  "lazy_provider": {
    "runtime_owner": "E0001-02",
    "cli_consumer": "E0001-08",
    "setup_type": "LiveRunSetup",
    "intent_type": "LiveRunIntent",
    "factory_trait": "ModelGatewayFactory",
    "factory_context_type": "ModelGatewayFactoryContext",
    "additive_constructor": "AgentRuntime::new_with_gateway_factory",
    "live_entry_point": "AgentRuntime::run_live",
    "preserve_existing_constructor": "AgentRuntime::new",
    "existing_constructor_wrapper": "FixedModelGatewayFactory",
    "setup_is_credential_free": true,
    "factory_registration_reads_credential": false,
    "factory_invocation_after_initial_checkpoint_reread": true,
    "factory_invocation_after_prepared_attempt_reread": true,
    "factory_failure_bytes_sent": 0,
    "factory_failure_increments_provider_dispatches": false,
    "factory_failure_attempt_state": "failed_terminal",
    "factory_failure_class": "terminal",
    "factory_failure_code": "gateway_factory_failed",
    "cli_factory_is_only_credential_reader": true,
    "dispatching_barrier_after_factory": true,
    "require_zero_factory_and_send_invocations_on_pre_secret_failure": true,
    "resume_reloads_and_compares_complete_evidence": true
  },
  "outbound_data": {
    "canonical_json": "proof-kernel-canonical-json",
    "instructions": "You are the Proof Release Manager for one synthetic local preview. Use exactly the declared proof_content_v2_release_publish function once with the supplied edition_id, preview environment, version_label, manifest_digest, and idempotency_key. Do not request, infer, quote, or disclose repository files, source code, secrets, credentials, private keys, customer data, or network resources. After the tool result, report only the publication_id, edition_id, environment, version_label, manifest_digest, artifact relative_path, artifact digest, and proof_id from that result. On continuation, these complete instructions still apply.",
    "initial_input_template": "Publish synthetic edition {edition_id} to preview as {version_label} using manifest {manifest_digest} and idempotency key {idempotency_key}.",
    "continuation_input_template": {
      "type": "function_call_output",
      "call_id": {"$runtime": "committed_function_call_id"},
      "output": {
        "$canonical_json_string": {
          "ok": true,
          "result": {"$runtime": "canonical_release_publish_v2_output"},
          "proof_id": {"$runtime": "proof_id"}
        }
      }
    },
    "continuation_directives": [
      "$runtime",
      "$canonical_json_string"
    ],
    "allowed": [
      "exact sealed instructions",
      "resolved synthetic initial input",
      "exact continuation input",
      "canonical governed tool result",
      "exact custom function name, description, and parameters schema"
    ],
    "prohibited": [
      "OPENAI_API_KEY",
      "environment variable values",
      "repository source",
      "arbitrary file bytes",
      "secrets",
      "credentials",
      "private keys",
      "real content",
      "customer data",
      "unapproved network resources"
    ],
    "required_digests": [
      "instructions_digest",
      "initial_input_digest",
      "parameters_schema_digest",
      "tool_declaration_digest",
      "tool_set_digest",
      "request_body_digest"
    ]
  },
  "tool": {
    "declaration": {
      "type": "function",
      "name": "proof_content_v2_release_publish",
      "description": "Publish one existing content edition as an immutable local preview artifact",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "edition_id", "environment", "version_label", "manifest_digest"],
        "properties": {
          "idempotency_key": {"type": "string", "format": "uuid"},
          "edition_id": {"type": "string", "format": "uuid"},
          "environment": {"type": "string", "const": "preview"},
          "version_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
          },
          "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      },
      "strict": true
    },
    "parameters_digest_schema": "proof-openai-function-parameters-digest/v1",
    "declaration_digest_schema": "proof-openai-function-declaration-digest/v1",
    "tool_set_digest_schema": "proof-openai-tool-set-digest/v1",
    "request_digest_schema": "proof-openai-responses-request-digest/v1",
    "tool_set_cardinality": 1,
    "require_exact_order": true,
    "require_complete_request_body_digest": true
  },
  "expected_calls": [
    {
      "function_name": "proof_content_v2_release_publish",
      "operation": "release.publish",
      "version": "v2",
      "arguments": {
        "idempotency_key": {"$binding": "idempotency_key"},
        "edition_id": {"$binding": "edition_id"},
        "environment": "preview",
        "version_label": {"$binding": "version_label"},
        "manifest_digest": {"$binding": "manifest_digest"}
      },
      "requires_approved_execution": true,
      "requires_delegation": true,
      "requires_process_restart": true
    }
  ],
  "allow_additional_calls": false,
  "artifact": {
    "schema": "proof-content-preview-artifact/v1",
    "manifest_schema": "proof-content-preview-manifest/v1",
    "digest_schema": "proof-content-preview-artifact-digest/v1",
    "digest_algorithm": "blake3-256",
    "manifest_digest_algorithm": "sha256",
    "relative_path_template": ".proof/data/previews/{edition_id}/{idempotency_key}.json",
    "require_canonical_compact_json": true,
    "require_no_overwrite": true,
    "require_single_artifact": true,
    "require_safe_workspace_relative_path": true,
    "require_persisted_file_verification": true,
    "environment": "preview"
  },
  "replay": {
    "policy": "required_uuidv7_exact_replay",
    "tuple": ["release.publish", "v2", {"$binding": "idempotency_key"}],
    "require_original_output_and_proof": true,
    "maximum_successful_mutations": 1,
    "claimed_or_failed_auto_retry": false,
    "require_completed_replay_check": true
  },
  "runtime_state": {
    "schema": "proof-agent-runtime-state/v2",
    "reject_unknown": true,
    "read_legacy_v1": true,
    "required_fields": [
      "schema", "agent_id", "run_id", "started_at", "process_epoch_id",
      "previous_response_id", "next_input", "pending_tool", "authority",
      "policy_evidence", "policy_binding", "provider", "attempts", "counters",
      "cumulative_usage", "cumulative_cost", "final_output", "terminal_error"
    ],
    "authority_required_fields": [
